{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bilderwerk View",
  "version": "0.3.2",
  "identifier": "de.sieber-bw.bilderwerk.view",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bilderwerk View",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Photography",
    "copyright": "© 2026 Kim Sieber",
    "shortDescription": "Bilderwerk View – Suche im KI-Bildkatalog",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Apple Development: Kim Jan Sieber (7TTFYF5286)"
    }
  }
}
